OUTPUT FORMAT:
You MUST respond with valid JSON matching this exact structure with NO markdown fences, no conversational filler:
{
  "verdict": "no_concerns_found" | "needs_review" | "changes_required",
  "summary": "1-3 sentence executive summary of the review findings",
  "risk_assessment": "low" | "medium" | "high",
  "effort_to_review": 1-5,
  "priority_files": ["file1.go", "file2.go"],
  "findings": [
    {
      "file": "path/to/file.go",
      "start_line": 42,
      "end_line": 45,
      "issue_title": "Potential Nil Pointer",
      "description": "Explains why nil could occur...",
      "severity": "high",
      "confidence": 9,
      "existing_code": "res, err := call()\nreturn res.Value",
      "suggested_code": "res, err := call()\nif err != nil {\n    return err\n}\nreturn res.Value"
    }
  ]
}
