# ==========================================
# pr-review-go Configuration Template
# Copy to .env and set your credentials
# ==========================================

# --- LLM Provider Settings ---
OPENAI_API_KEY=sk-your-openai-api-key-here
# Optional custom endpoint (e.g. for Ollama: http://host.docker.internal:11434/v1)
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# --- GitHub Configuration ---
# Personal Access Token with repo scope
GITHUB_TOKEN=ghp_your-github-token-here
# Leave blank for GitHub SaaS, or specify e.g. https://github.enterprise.corp/api/v3
GITHUB_BASE_URL=
# Secret configured in repository webhook settings
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# --- Bitbucket Cloud Configuration ---
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=

# --- Bitbucket Data Center / Server Configuration ---
BITBUCKET_SERVER_BASE_URL=https://bitbucket.internal.corp
BITBUCKET_SERVER_TOKEN=your-bitbucket-pat-token

# --- Webhook Daemon Port ---
PORT=8080
